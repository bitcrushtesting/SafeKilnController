*.kicad_prl
~*.lck
# KiCad automatic backups
*-backups/
fp-info-cache
*.kicad_sch-bak
*.kicad_pcb-bak
# Generated exports; regenerate with kicad-cli
*.net
*-schematic.pdf
gerbers/
jlcpcb/

# --- ESP-IDF / firmware --------------------------------------------------
build/
build-host/
build-*/
coverage/
sdkconfig
sdkconfig.old
sdkconfig.hw
managed_components/
dependencies.lock
*.o
*.d

# --- OpenSCAD ------------------------------------------------------------
*.stl
*.3mf
*.amf

# --- Editors / OS --------------------------------------------------------
.history/
.vscode/
.DS_Store

# Secure boot signing keys (tools/secure-boot.py, SEC-05).
#
# A committed signing key is worse than no secure boot at all: it makes every
# device that trusts it signable by anyone who can read the repository, and the
# eFuse that trusts it cannot be un-burnt. Patterns rather than one filename,
# because the next person will name it something else.
*.pem
*secure_boot_signing_key*
*_signing_key*
secure_boot_digest.bin

# Release artefacts from tools/update-manifest.py: a signed manifest and the
# image it names belong on the update server, not in git. The public half of the
# signing key is the exception and IS committed, as the generated header the
# firmware compiles in (SWR-UPD-11); `*.pem` above keeps the private half out.
dist/

# The generated Unit Design Document (tools/udd.sh). It is generated from the
# headers on demand and published as a CI artifact; a copy in git would be the
# second description of the code that generating it exists to avoid.
firmware/supervisor/build-udd/

# Python bytecode from the tools/ scripts.
__pycache__/
*.pyc
