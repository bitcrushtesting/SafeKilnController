# SPDX-FileCopyrightText: 2026 Bitcrush Testing
# SPDX-License-Identifier: GPL-3.0-or-later
#
# Static analysis configuration (SWR-NFR-25, SWR-TST-24).  CI runs this and a finding
# fails the build -- there is no suppressions baseline, by choice: a baseline
# records violations as accepted, and the ones here were either fixed or the
# check was switched off for a stated reason you can read below.
#
# ---------------------------------------------------------------------------
# WHY THIS IS NOT "MISRA"
# ---------------------------------------------------------------------------
# clang-tidy implements no MISRA checks at all -- not one, in any release.  The
# `hicpp-*` module that used to approximate High Integrity C++ was ~90 % aliases
# to the checks below and has been removed from LLVM entirely (gone in 23.x);
# `hicpp-no-malloc` is now `cppcoreguidelines-no-malloc`, `hicpp-signed-bitwise`
# is `bugprone-signed-bitwise`, and so on.  What is enabled here IS that
# content, reached by its current names.
#
# Free MISRA tooling means cppcheck's addon, which implements MISRA **C** 2012
# only (its own header: "Partially reused for MISRA C++ 2008") and needs a
# rule-texts file nobody may redistribute.  Genuine MISRA C++:2023 checking is
# commercial -- Cppcheck Premium, QAC, LDRA, Parasoft.
#
# So: nothing in this repository may claim MISRA compliance.  See
# docs/safety.md section 9.3.  This configuration is a high-integrity C++
# profile, which is a different and more honest claim.
#
# ---------------------------------------------------------------------------
# WHAT IS SWITCHED OFF, AND WHY
# ---------------------------------------------------------------------------
# Every disabled check is disabled for a reason, not because it was noisy.
# Deferred items are tracked in tasklist.md section F, not silently dropped.
#
#   avoid-magic-numbers ........ Thresholds already live in named config fields
#                                (kiln_safety_cfg_t).  The literals this flags
#                                are the *defaults* beside the field they
#                                initialise, which is where they are readable.
#   avoid-c-arrays ............. The firmware has no heap (zero malloc/free, by
#                                design).  Fixed C arrays in the port structs
#                                are deliberate and ABI-visible; std::array
#                                would churn the boundary SWA-01 depends on.
#   pro-bounds-* ............... Wants gsl::at() and forbids the pointer walking
#                                the log ring and codec are built on.  No GSL
#                                dependency (UR-CON-04 vendoring rules).
#   pro-type-vararg ............ printf-family in diagnostics only.
#   macro-usage ................ Header guards and SPDX.
#   use-enum-class ............. DEFERRED, 31 enums / 223 enumerators / 2 530
#                                references.  The C-callability half of this
#                                question is now settled -- nothing outside
#                                app_main is extern "C", so the port layer is
#                                C++ only -- but scoping the enumerators
#                                renames the project's whole vocabulary, which
#                                the requirements traceability greps for.
#                                tasklist F3, still a decision rather than a
#                                task.
#   enum-size .................. The underlying type of a port enum is ABI, and
#                                the log record format pins it (section 10.2),
#                                so it cannot change without a format version
#                                bump.  Same boundary as optin.performance.
#                                Padding below.
#   include-cleaner ............ Fights the layered port headers on purpose:
#                                it wants every transitive include spelled out,
#                                which defeats the single-include-per-port
#                                convention of architecture 5.2.
#   identifier-length .......... `dt`, `pv`, `sp`, `kp`, `ki`, `kd` are the
#                                domain's own names, and spelling them out
#                                makes the control maths less readable, not
#                                more.
#   uppercase-literal-suffix ... Pure style; 1280.0f vs 1280.0F changes nothing
#                                and would touch ~1500 lines of tested code.
#   easily-swappable-parameters  Not actionable without reshaping every API into
#                                wrapper types.
#   no-recursion ............... The JSON parser recurses by design, bounded.
#   avoid-do-while ............. do {} while (0) is the function-like-macro
#                                idiom, and the test harness is built on it.
#   optin.performance.Padding .. kiln_run_record_t is a *persisted* layout
#                                (section 10.2).  Reordering its fields to save
#                                9 bytes would invalidate every run record
#                                already on a device's flash.
#
# Two component profiles narrow this further, each for a stated reason:
# firmware/controller/test/ (the KILN_TEST macro, and negative tests that cast 999 to an
# enum on purpose) and firmware/controller/components/kiln_hal_esp32s3/ (findings that
# live inside ESP-IDF's own macros).  Read those files; neither relaxes
# anything in firmware/controller/components or firmware/controller/main.

Checks: >
  -*,
  bugprone-*,
  cert-*,
  clang-analyzer-*,
  concurrency-*,
  cppcoreguidelines-*,
  misc-*,
  performance-*,
  portability-*,
  readability-braces-around-statements,
  readability-implicit-bool-conversion,
  readability-inconsistent-declaration-parameter-name,
  readability-misleading-indentation,
  readability-redundant-control-flow,
  readability-redundant-nested-if,
  readability-simplify-boolean-expr,
  -bugprone-easily-swappable-parameters,
  -cppcoreguidelines-avoid-c-arrays,
  -cppcoreguidelines-avoid-magic-numbers,
  -cppcoreguidelines-init-variables,
  -cppcoreguidelines-macro-usage,
  -cppcoreguidelines-use-enum-class,
  -cppcoreguidelines-pro-bounds-array-to-pointer-decay,
  -cppcoreguidelines-pro-bounds-constant-array-index,
  -cppcoreguidelines-pro-bounds-pointer-arithmetic,
  -cppcoreguidelines-pro-type-vararg,
  -cppcoreguidelines-avoid-do-while,
  -clang-analyzer-optin.performance.Padding,
  -misc-include-cleaner,
  -misc-no-recursion,
  -performance-enum-size,
  -misc-unused-parameters,
  -misc-redundant-expression,
  -bugprone-branch-clone,
  -bugprone-unchecked-string-to-number-conversion,
  -bugprone-implicit-widening-of-multiplication-result,
  -cert-err34-c,
  -cert-exp42-c,
  -cert-flp37-c,
  -cert-dcl50-cpp,
  -concurrency-mt-unsafe,
  -cppcoreguidelines-avoid-goto,
  -cppcoreguidelines-avoid-non-const-global-variables,
  -cppcoreguidelines-owning-memory,
  -cppcoreguidelines-pro-type-member-init

# ---------------------------------------------------------------------------
# CHECK OPTIONS
# ---------------------------------------------------------------------------
CheckOptions:
  # const-correctness analyses local variables, not signatures.
  #
  # With parameters included it demands `const void *ctx` on every port adapter
  # that only reads -- and `void *ctx` is the ports-and-adapters boundary SWA-01
  # rests on, the same signature for every slot in a vtable whether that slot
  # mutates or not.  The check cannot tell a vtable slot from an ordinary
  # helper, and it also wants `const char **argv` on main(), which is not a
  # signature main() is allowed to have.
  #
  # So signatures are the author's call and locals are the check's.  Locals,
  # pointees included, are still gated: what a function does with a pointer it
  # derived itself is exactly what this is useful for.
  # Note for whoever bumps LLVM_VERSION: this option does not exist before
  # LLVM 21, and neither does the pointee analysis it governs.  Under the
  # pinned 20 it is ignored and the check reports values only, so CI is a
  # subset of what a newer local clang-tidy reports -- the safe direction, but
  # it does mean a local run can be stricter than the gate.
  misc-const-correctness.AnalyzeParameters: false

WarningsAsErrors: '*'

# The supervisor's headers are in here too, because SWA-22's whole argument is
# that its firmware is independently reviewable, and a header no analyser looks
# at is not that.  `board/stm32g031.h` is the one exclusion: it is *generated*
# from ST's CMISIS-SVD by tools/gen-stm32g031-header.py, so a finding in it is a
# finding against the generator, and editing the output is what the file's own
# header tells you not to do.  `pins.h` and `cortex_m0plus.h` are hand-written
# and are gated.
HeaderFilterRegex: 'firmware/(controller/(components|host)/.*/include/.*|supervisor/(core|protocol)/include/.*|supervisor/board/(pins|cortex_m0plus))\.h$'
FormatStyle: file
