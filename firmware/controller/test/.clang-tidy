#
# Test code inherits the root profile and relaxes the checks that only make
# sense against production code.  Every one of these is disabled because the
# test is *deliberately* doing the thing the check objects to -- which is what
# a negative test is.  None of them is disabled in firmware/controller/components.
#
#   EnumCastOutOfRange ..... test_faults casts 999 and 99 to a fault code, and
#                            test_safety_current casts 200, precisely to prove
#                            an out-of-range code is rejected (SWR-SAF-19).
#   NullDereference ........ the suites pass NULL deliberately to check the
#                            SWR-NFR-17 argument guards return an error instead of
#                            faulting.
#   insecureAPI.strcpy ..... fixed test fixtures of known length.
#   signed-char-misuse ..... the fuzz and profile suites feed deliberately
#                            hostile bytes.
#   simplify-boolean-expr .. fires inside the check-macro expansion, not in
#                            anything a person wrote.
#   use-anonymous-namespace  890 findings, 796 of them the two static functions
#   use-internal-linkage ... KILN_TEST() expands to -- so nine in ten are the
#                            harness, not the suite.  They cannot be fixed at
#                            the macro either: wrapping them would mean opening
#                            a namespace the caller's `{ body }` has to close,
#                            and the macro has no way to emit the closing
#                            brace.  Nor can a NOLINT reach them, because the
#                            diagnostic lands on the expansion site.
#
#                            The remaining 94 are hand-written fixtures, and
#                            `static` at file scope is correct C++ for them --
#                            the check prefers an anonymous namespace, which is
#                            a style, not a defect.  firmware/controller/components and
#                            firmware/controller/main are gated by both checks and carry
#                            no `static` free functions at all.
InheritParentConfig: true
Checks: >
  -misc-use-anonymous-namespace,
  -misc-use-internal-linkage,
  -clang-analyzer-optin.core.EnumCastOutOfRange,
  -clang-analyzer-core.NullDereference,
  -clang-analyzer-security.insecureAPI.strcpy,
  -bugprone-signed-char-misuse,
  -cert-str34-c,
  -readability-simplify-boolean-expr
