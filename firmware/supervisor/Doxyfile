#
# The supervisor's Unit Design Document, generated from the source.
#
#   tools/udd.sh                      build it into build-udd/
#   doxygen firmware/supervisor/Doxyfile
#
# ===========================================================================
# WHY THE UDD IS GENERATED AND NOT WRITTEN
# ===========================================================================
# Level 5 of the V-model (docs/v-model-process.md) wants, per unit: its
# functions, its parameters and their value ranges, its algorithms, its state
# machines and its error behaviour, each traceable up to the architecture and
# down to a test.  A separate document saying all that about code is a document
# that disagrees with the code, and the disagreement is discovered by whoever
# is auditing rather than by whoever is editing.
#
# So the unit design lives in the headers, beside the thing it describes, and
# this produces the document from it.  The traceability is the same mechanism:
# \implements and \verifiedby below become cross-referenced index pages, so
# "which unit realises SWR-SAF-37" and "what covers sup_step" are answerable
# from the generated document rather than from a maintained table.
#
# ---------------------------------------------------------------------------
# WHAT AN ASSESSOR IS LOOKING FOR, AND WHICH ALIAS CARRIES IT
# ---------------------------------------------------------------------------
# EN ISO 13849-1:2023 cl. 4.6 and EN IEC 60730-1 Annex H do not prescribe a
# document format.  What a notified body reads a unit design for is narrower
# than "documentation" and is always the same five questions:
#
#   What is this for, and what requirement makes it exist?   \implements
#   What may I pass it, and what will it give me back?       \param, \retval,
#                                                            \range
#   What does it do when the input is wrong?                 \errorbehaviour
#   Why is it like this rather than the obvious way?         \rationale
#   How do I know it works?                                  \verifiedby
#
# The aliases exist so those five are answered in a fixed place per unit rather
# than being somewhere in a paragraph, and so that a missing one is visible.
# \rationale is the one people leave out and the one an assessor asks about
# first on a safety function: a decision with no recorded reason has to be
# re-derived by the person reviewing it.

DOXYFILE_ENCODING      = UTF-8
PROJECT_NAME           = "Safe Kiln Controller: Supervisor Unit Design"
PROJECT_BRIEF          = "Level 5 of the V-model, generated from the source (SWA-22)"
OUTPUT_DIRECTORY       = build-udd
CREATE_SUBDIRS         = NO
OUTPUT_LANGUAGE        = English

# The supervisor is C++ written in a C shape: no templates, no classes, no
# namespaces outside the board layer.  This output mode suits it and keeps the
# document readable by somebody who does not write C++ for a living, which an
# assessor may not.
OPTIMIZE_OUTPUT_FOR_C  = YES

FULL_PATH_NAMES        = YES
STRIP_FROM_PATH        = ../..
JAVADOC_AUTOBRIEF      = YES
TAB_SIZE               = 4
MARKDOWN_SUPPORT       = YES
AUTOLINK_SUPPORT       = YES

# --- the fields a unit design has to carry -------------------------------
#
# Each \xrefitem builds its own index page, which is what turns these from
# comments into traceability: "Requirements implemented" lists every unit
# against the SWR- it realises, and the reverse direction is one click.
ALIASES += "implements=\xrefitem implements \"Implements\" \"Requirements implemented\" "
ALIASES += "derivedfrom=\xrefitem derivedfrom \"Derived from\" \"Architecture traceability\" "
ALIASES += "verifiedby=\xrefitem verifiedby \"Verified by\" \"Unit verification\" "
ALIASES += "errorbehaviour=\par Error behaviour:^^"
ALIASES += "rationale=\par Design rationale:^^"
ALIASES += "rangeof=\par Permitted range:^^"
ALIASES += "statemachine=\par State machine:^^"
ALIASES += "sideeffects=\par Side effects:^^"
ALIASES += "reentrancy=\par Reentrancy:^^"
ALIASES += "resources=\par Resource use:^^"
ALIASES += "safetyclass=\xrefitem safetyclass \"Safety class\" \"Safety classification\" "

# --- what goes in ---------------------------------------------------------
#
# core/ and protocol/ are the safety function and are documented to the letter.
# board/ and src/ are the silicon and the composition root; they are in the
# document because a unit design that stops at the platform boundary does not
# describe the unit that ships.
INPUT                  = core/include \
                         core/src \
                         protocol/include \
                         src \
                         board \
                         doc
FILE_PATTERNS          = *.h *.cpp *.dox
RECURSIVE              = YES
EXCLUDE                = test
EXCLUDE_PATTERNS       = */build/* */stm32g031.h
USE_MDFILE_AS_MAINPAGE =

# stm32g031.h is excluded deliberately: it is 4 000 generated register
# definitions from ST's CMSIS-SVD, it is not anybody's unit design, and
# including it would bury the four files that are.

# --- the one exemption, at the hardware boundary --------------------------
#
# Register addresses and pin numbers, 44 of them across board/pins.h and
# board/cortex_m0plus.h. The files stay IN the document, with their \file
# blocks, the pin table and the compile-time proofs that no two pins share a
# bit; what is exempted is an individual entry per register address.
#
# The reason is the one the board layer's .clang-tidy already gives for its own
# exemptions: a finding inherent to the hardware boundary is exempted THERE and
# nowhere else. The provenance of these numbers is what an assessor needs and
# it is stated once, in the file blocks: the pinout and alternate functions
# from STM32CubeMX's MCU database, the register bits from the CMSIS-SVD,
# neither from anybody's recollection. Forty-four entries saying "SYST_RVR is
# the SysTick reload register" would add no fact that the name does not.
#
# core/ and protocol/, which are the safety function, carry NO exemption of any
# kind and are complete at 76 of 76.
# The permit polarities and SUP_BIT are NOT in this list and are documented
# individually: a polarity is the difference between permitting heat and
# refusing it, and SUP_BIT is what the compile-time pin-map proofs are built
# from. The exemption covers addresses and numbers, not meaning.
# SUP_RCC_APBENR* and SUP_RCC_IOPENR* rather than SUP_RCC_*: the wider pattern
# reached into core/ and silently removed selfcheck.h's five clock-integrity
# constants, which are part of the safety function and are documented. Nothing
# warned, because excluding a symbol is not the same as it being undocumented;
# the coverage count caught it, which is the second time that number has earned
# its place.
EXCLUDE_SYMBOLS        = SYST_* SUP_PIN_* SUP_PORT* SUP_SYSCLK_HZ \
                         SUP_AF_* SUP_RCC_APBENR* SUP_RCC_IOPENR* \
                         SUP_PERMIT_GPIO_*

# --- extraction: the half of the gate doxygen can enforce ------------------
#
# These four values are the only combination that makes an undocumented
# function fail the build, which was established by experiment rather than by
# reading, because the interaction is not obvious and two of the four
# combinations are silent:
#
#   EXTRACT_ALL   HIDE_UNDOC_MEMBERS   undocumented function
#   NO            YES                  SILENT, the member is simply dropped
#   NO            NO                   WARNS           <-- what is set here
#   YES           YES                  silent: doxygen disables the warning
#   YES           NO                   silent, same reason
#
# EXTRACT_ALL = YES is the trap: it looks like "document everything" and it
# switches WARN_IF_UNDOCUMENTED off, so the document fills with empty entries
# and the build stays green. For a safety target that is the worst of the four.
#
# HIDE_UNDOC_MEMBERS = NO is what makes the difference, and it has a visible
# cost: an undocumented member appears in the document as a bare declaration.
# That is the right cost. A gap you can see in the output is a gap somebody
# fixes; a member silently dropped is a unit design that looks finished.
#
# WHAT NEITHER SETTING CAN CATCH, and the reason tools/udd-coverage.py exists:
# a file with no \file block at all is invisible to doxygen entirely, members
# and all, with no warning of any kind. Two of this component's four headers
# were in exactly that state while the build was green. Checking that every
# input file carries a \file block is not something doxygen will do, so the
# script does it.
EXTRACT_ALL            = NO
EXTRACT_PRIVATE        = NO
EXTRACT_STATIC         = YES
EXTRACT_LOCAL_CLASSES  = YES
HIDE_UNDOC_MEMBERS     = NO
HIDE_UNDOC_CLASSES     = NO
INTERNAL_DOCS          = NO
SHOW_INCLUDE_FILES     = YES
SHOW_USED_FILES        = YES
SORT_MEMBER_DOCS       = NO
SORT_BRIEF_DOCS        = NO

# Source browsing is on: an assessor reading a unit design wants the code one
# click away, and a generated document that hides it invites the question of
# whether the two agree.
SOURCE_BROWSER         = YES
INLINE_SOURCES         = NO
STRIP_CODE_COMMENTS    = NO
REFERENCED_BY_RELATION = YES
REFERENCES_RELATION    = YES
VERBATIM_HEADERS       = YES

# --- warnings are the gate ------------------------------------------------
QUIET                  = YES
WARNINGS               = YES
# Every one of these is on, and each catches a different way a unit design can
# be incomplete:
#
#   WARN_IF_UNDOCUMENTED   a function, struct or constant with nothing said
#   WARN_IF_DOC_ERROR      a comment that does not mean what it looks like
#   WARN_IF_INCOMPLETE_DOC a documented function missing some of its parameters
#   WARN_NO_PARAMDOC       ... or missing all of them
#
# FAIL_ON_WARNINGS rather than YES: it finishes the run and reports everything,
# then fails. YES stops at the first, which turns documenting a component into
# as many build cycles as it has gaps.
WARN_IF_UNDOCUMENTED   = YES
WARN_IF_DOC_ERROR      = YES
WARN_IF_INCOMPLETE_DOC = YES
WARN_NO_PARAMDOC       = YES
WARN_AS_ERROR          = FAIL_ON_WARNINGS
WARN_FORMAT            = "$file:$line: $text"
WARN_LOGFILE           = build-udd/doxygen-warnings.txt

# --- output ---------------------------------------------------------------
GENERATE_HTML          = YES
HTML_OUTPUT            = html
HTML_COLORSTYLE        = LIGHT
GENERATE_TREEVIEW      = YES
DISABLE_INDEX          = NO
FULL_SIDEBAR           = NO
SEARCHENGINE           = YES

# LaTeX is off by default because it needs a TeX installation that nothing else
# in this project needs.  Turn it on when a PDF has to be handed over: the
# document is the same either way, which is the point of generating it.
GENERATE_LATEX         = NO
GENERATE_XML           = YES
XML_OUTPUT             = xml

# XML is on so the document is machine-readable as well as human-readable: a
# traceability check that wants to ask "is every SWR-SAF- realised by a unit"
# reads the XML rather than scraping HTML.

# --- diagrams -------------------------------------------------------------
#
# HAVE_DOT is set to YES by tools/udd.sh, which refuses to run without
# graphviz. It stopped being optional when the headers gained \dot blocks of
# their own: the trip logic's state machine in trip.h and the program-sequence
# graph in selfcheck.h. Those two are the pictures an assessment of a safety
# function asks for, and \dot was chosen over PlantUML because graphviz is
# already installed beside doxygen for the call graphs, while PlantUML would
# add a Java runtime and a jar to vendor for notation this does not need.
#
# The value here stays NO so that a bare `doxygen Doxyfile` outside the script
# produces a document rather than an error about a tool it was not told about.
HAVE_DOT               = NO
CALL_GRAPH             = NO
CALLER_GRAPH           = NO
INCLUDE_GRAPH          = NO
INCLUDED_BY_GRAPH      = NO
